{
  "manifest_version": 3,
  "name": "[ACTO v2.0] 12/07",
  "version": "2.20.0",
  "version_name": "Version PRO v2 (12/07/26)",
  "description": "🔥 ACTO v2 | Update 12/07/2026 — Prompts ilimitados, Modo Plano, novo sistema de Skills, melhorias de estabilidade, auditoria inteligente e recursos avançados para Lovable.dev. 🚀 🌐 https://acto-lov.online",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webRequest",
    "windows",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://lovable.app/*",
    "https://*.lovable.app/*",
    "https://*.supabase.co/*",
    "https://www.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://*.storage.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://www.youtube-nocookie.com/*",
    "https://i.ytimg.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://acto-lov.online/*",
    "https://www.acto-lov.online/*",
    "https://skillforge-acto.lovable.app/*",
    "https://notas-lumen.lovable.app/*",
    "https://www.sharkcodemode.online/*",
    "https://sharkcodemode.online/*"
  ],
  "action": {
    "default_title": "🔥 ACTO V.4.30 | Update 04/06/2026",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.acto-lov.online https://acto-lov.online https://skillforge-acto.lovable.app https://notas-lumen.lovable.app https://www.sharkcodemode.online https://sharkcodemode.online https://www.youtube.com https://www.youtube-nocookie.com;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "lovable-dom-patch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": [
        "acto-chat-history.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lovable-token-hook.js",
        "index.html",
        "acto-config.js",
        "acto-create-project-bridge.js",
        "acto-publish-project-bridge.js",
        "acto-paste-attachment-bridge.js",
        "acto-youtube-music-bridge.js",
        "acto-store-bridge.js",
        "acto-notes-bridge.js",
        "acto-remover-bridge.js",
        "acto-watermark-bridge.js",
        "acto-checkpoint-bridge.js",
        "acto-attachment-thumbs-bridge.js",
        "acto-i18n-bridge.js",
        "acto-notes-page-modal.js",
        "assets/*",
        "ads/*.png",
        "music-pip.html",
        "music-pip.js"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ]
    }
  ]
}